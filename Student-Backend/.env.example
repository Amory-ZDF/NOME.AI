# Allowed: development, test, production. Production requires STUDENT_ID.
NODE_ENV=development
# Non-blank local bind address and integer port from 1 to 65535.
HOST=127.0.0.1
PORT=3001
# PostgreSQL connection URL (docker compose up -d starts a local Postgres).
# Keep SQLite file: URLs only for tests — each concurrent writer needs its own file.
DATABASE_URL=postgresql://nome:nome@localhost:5432/nome
# Fixed development student scope; this is not request authentication.
STUDENT_ID=stu-001
# Python AI agent base URL (similar-question retrieval + diagnosis).
AGENT_URL=http://127.0.0.1:8000
# Comma-separated, origin-only HTTP(S) browser allowlist.
CORS_ORIGINS=http://localhost:5173
# Allowed: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
