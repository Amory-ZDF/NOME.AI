# Allowed: development, test, production. Production requires STUDENT_ID.
NODE_ENV=development
# Non-blank local bind address and integer port from 1 to 65535.
HOST=127.0.0.1
PORT=3001
# Required SQLite file: URL; keep each concurrent writer on a different file.
DATABASE_URL=file:./dev.db
# Fixed development student scope; this is not request authentication.
STUDENT_ID=stu-001
# Comma-separated, origin-only HTTP(S) browser allowlist.
CORS_ORIGINS=http://localhost:5173
# Allowed: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
# Internal Python Agent origin. Production must set this explicitly.
AGENT_BASE_URL=http://127.0.0.1:8000
# Bounded internal Agent request timeout in milliseconds (1-60000).
AGENT_TIMEOUT_MS=10000
