# Runtime mode: development, test, or production.
NODE_ENV=development
# Local bind address and service port.
HOST=127.0.0.1
PORT=3001
# Local SQLite database file.
DATABASE_URL=file:./dev.db
# Student whose data this service exposes.
STUDENT_ID=stu-001
# Comma-separated HTTP(S) origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
# Logging threshold: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info
