# NOME.AI Backend — Environment Variables
# Copy this file to .env and fill in your actual keys.

# ------------------------------------------------------------------
# DeepSeek (https://platform.deepseek.com)
# NOTE: No sign-up bonus. You must top up before the API works.
# ------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------
# Qwen via Alibaba Cloud Model Studio (百炼)
# Base URL: https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Docs: https://help.aliyun.com/zh/model-studio
# ------------------------------------------------------------------
QWEN_API_KEY=sk-your-qwen-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Embeddings model for graph vectorization (Qwen only — DeepSeek has no /embeddings).
# text-embedding-v3 → 1024 dims (default); v2 → 1536; v4 → 1024.
QWEN_EMBEDDING_MODEL=text-embedding-v3

# NOTE: If you prefer to use the token-plan endpoint, uncomment the line below:
# QWEN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ------------------------------------------------------------------
# Application settings
# ------------------------------------------------------------------
LLM_PROVIDER=deepseek
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
MEMORY_HALF_LIFE_DAYS=21

# ------------------------------------------------------------------
# Memory persistence (optional)
# Set DATABASE_URL to persist memory records to Postgres (the same
# Postgres instance the TS backend uses). Leave empty to use the
# in-memory MemoryStore (development/demo).
# ------------------------------------------------------------------
# DATABASE_URL=postgresql://nome:nome@localhost:5432/nome
