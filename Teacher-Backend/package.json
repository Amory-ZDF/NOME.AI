{
  "name": "nome-ai-teacher-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:prepare && cross-env DATABASE_URL=file:./prisma/test.db vitest run --no-file-parallelism",
    "test:watch": "cross-env DATABASE_URL=file:./prisma/test.db vitest --no-file-parallelism",
    "test:prepare": "cross-env DATABASE_URL=file:./prisma/test.db prisma db push --force-reset"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^6.0.0",
    "pg": "^8.23.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "cross-env": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
